{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Footnote",
  "version": "0.1.0",
  "identifier": "dev.footnote.one",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Footnote",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680
      },
      {
        "label": "mini",
        "title": "Footnote",
        "width": 380,
        "height": 248,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
