#!/usr/bin/env bash
# ADR 0002: Actions is blocked by billing, so the checks run here before anything leaves the machine.
# Enable once per clone: git config core.hooksPath .githooks. Skip for a docs-only push with FOOTNOTE_SKIP_CHECK=1.
[[ -n ${FOOTNOTE_SKIP_CHECK:-} ]] && exit 0
# git exports GIT_DIR and friends to hooks; they make the rust-analyzer test inside check.sh fail, so run it with a clean git environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
exec "$(dirname "$0")/../scripts/check.sh"
